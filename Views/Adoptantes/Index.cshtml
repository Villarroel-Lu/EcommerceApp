@model List<EcommerceApp.Models.ApplicationUser>
@{
    ViewData["Title"] = "Adoptantes registrados";
    // ViewBag.ConteosSolicitudes es un Dictionary<string, int> armado en
    // el controlador: Id del usuario -> cuántas solicitudes ha hecho.
    var conteos = ViewBag.ConteosSolicitudes as Dictionary<string, int>;
}

<div class="catalogo-full-ancho">
    <h2 class="mb-3">👥 Adoptantes registrados</h2>

    <div class="table-responsive" style="background:var(--color-blanco); border-radius:16px; padding:12px;">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Solicitudes hechas</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var adoptante in Model)
                {
                    <tr>
                        <td>@adoptante.Nombre @adoptante.Apellido</td>
                        <td>@adoptante.Email</td>
                        <td>
                            @(conteos != null && conteos.TryGetValue(adoptante.Id, out var total) ? total : 0)
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@adoptante.Id" class="btn btn-sm btn-adoptapatitas-outline">
                                Ver detalle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="mt-3">Todavía no hay adoptantes registrados.</p>
    }
</div>