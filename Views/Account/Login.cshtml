@model EcommerceApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";

    // Usa la plantilla especial de login/registro (sin navbar ni footer),
    // ver Views/Shared/_LayoutAuth.cshtml. Ya no hace falta "OcultarNavbar".
    Layout = "_LayoutAuth";
}

@* "auth-pantalla" ocupa TODA la ventana y centra el panel (horizontal y
   vertical). Sus estilos están en adoptapatitas.css, bloque V10. *@
<div class="auth-pantalla">
    <!-- Video de fondo: autoplay + muted + loop son obligatorios para
         que los navegadores permitan la reproducción automática.
         playsinline evita que se abra a pantalla completa en celulares. -->
    <video class="auth-bg-video" autoplay muted loop playsinline>
        <source src="https://azselqmobzpcongydmbt.supabase.co/storage/v1/object/public/inicio/fondo%20patitas.mp4" type="video/mp4">
    </video>
    <div class="auth-bg-overlay"></div>

    <div class="row g-0 shadow-sm rounded-4 overflow-hidden mx-auto login-panel-contenedor">

        <!-- Columna izquierda: imagen decorativa (oculta en pantallas chicas) -->
        <div class="col-md-5 login-panel-imagen d-none d-md-flex">
            <img src="https://azselqmobzpcongydmbt.supabase.co/storage/v1/object/public/inicio/WhatsApp%20Image%202026-09-16%20at%2014.05.39.jpeg" alt="Perrito y gatito juntos" />
        </div>

        <!-- Columna derecha: formulario -->
        <div class="col-md-7 login-panel-formulario">
            @* Enlace para volver al catálogo: como el catálogo ahora es la página
           principal, quien llegue aquí puede regresar a ver las mascotas. *@
            <a asp-controller="Mascotas" asp-action="Index"
               class="small text-decoration-none align-self-start mb-3" style="color:var(--color-primario);">
                ← Volver a ver las mascotas
            </a>

            <h2>Iniciar sesión</h2>
            <p class="text-muted">Ingresa a tu cuenta para seguir cambiando vidas.</p>

            <form asp-action="Login" method="post" class="form-adoptapatitas">
                @* Campo oculto: reenvía al servidor a dónde volver después del login
               (lo llena Account/Login cuando alguien tocó "Adoptar" sin sesión). *@
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" placeholder="tucorreo@ejemplo.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-adoptapatitas-primario w-100">Iniciar sesión</button>
            </form>

            <div class="text-center my-3 text-muted">o</div>

            <!-- Login externo: cada botón manda el nombre del proveedor
             configurado en Program.cs (Google / Facebook / GitHub) -->
            <form asp-action="ExternalLogin" asp-controller="Account" method="post" class="social-login-icons">
                @* Mismo campo oculto para los botones de Google / GitHub: así
               también vuelven a la página de adopción después de entrar. *@
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <button type="submit" name="provider" value="Google" class="btn-icon-social" title="Iniciar sesión con Google">
                    <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                        <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" />
                        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" />
                        <path fill="#FBBC05" d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z" />
                        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.167 6.656 3.58 9 3.58z" />
                    </svg>
                </button>
                <button type="submit" name="provider" value="GitHub" class="btn-icon-social" title="Iniciar sesión con GitHub">
                    <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                        <path fill="#181717" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                    </svg>
                </button>
            </form>

            @* asp-route-returnUrl: si venía de tocar "Adoptar", el registro también
           recuerda a dónde volver. *@
            <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-adoptapatitas-outline w-100 mt-3">Crear cuenta</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}