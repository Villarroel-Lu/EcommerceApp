@model EcommerceApp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    ViewData["OcultarNavbar"] = true;
}

<div class="login-page-wrapper">
    <video class="login-bg-video" autoplay muted loop playsinline>
        <source src="~/videos/login-fondo.mp4" type="video/mp4">
    </video>
    <div class="login-bg-overlay"></div>

    <div class="registro-panel" style="max-width:480px;">
        <h2>🐾 Crear cuenta</h2>
        <p class="text-muted mb-4">
            Solo lo básico por ahora. Cuando quieras adoptar, te pediremos
            algunos datos más para verificar tu identidad.
        </p>

        <form asp-action="Register" method="post" class="form-adoptapatitas">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-control mb-3" oninput="this.value = this.value.replace(/[^a-zA-ZÀ-ÿ\s]/g, '')" />
            <span asp-validation-for="Nombre" class="text-danger"></span>

            <label asp-for="Apellido"></label>
            <input asp-for="Apellido" class="form-control mb-3" oninput="this.value = this.value.replace(/[^a-zA-ZÀ-ÿ\s]/g, '')" />
            <span asp-validation-for="Apellido" class="text-danger"></span>

            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control mb-3" placeholder="tucorreo@ejemplo.com" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control mb-3" />
            <span asp-validation-for="Password" class="text-danger"></span>

            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

            <button type="submit" class="btn btn-adoptapatitas-primario w-100 mt-4">Registrarme</button>
        </form>

        <a asp-action="Login" class="btn btn-adoptapatitas-outline w-100 mt-2">Ya tengo cuenta</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}