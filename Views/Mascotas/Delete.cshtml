@model EcommerceApp.Models.Mascota
@{
    ViewData["Title"] = "Eliminar mascota";
}

<h2>¿Eliminar esta mascota?</h2>
<p class="text-danger">Esta acción no se puede deshacer.</p>

<div class="card card-mascota" style="max-width:300px;">
    <img src="@(Model.FotoUrl ?? "/images/mascota-sin-foto.png")" alt="Foto de @Model.Nombre" />
    <div class="card-body">
        <h5>@Model.Nombre</h5>
        <p class="text-muted small">@Model.Tipo · @Model.Edad</p>
    </div>
</div>

<!-- Formulario separado del de Create/Edit: solo manda el Id para borrar -->
<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-outline-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-adoptapatitas-outline">Cancelar</a>
</form>