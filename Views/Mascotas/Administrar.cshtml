@model IEnumerable<EcommerceApp.Models.Mascota>
@{
    ViewData["Title"] = "Administrar mascotas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Panel de administración - Zoonosis</h2>
    <a asp-action="Create" class="btn btn-adoptapatitas-primario">+ Nueva mascota</a>
</div>

<!-- A diferencia del catálogo público (Index), aquí se ve TODO
     (disponibles y ya adoptadas) en una tabla, no en tarjetas. -->
<table class="table align-middle bg-white rounded-3 overflow-hidden">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Color</th>
            <th>Edad</th>
            <th>Sexo</th>
            <th>Estados de salud</th>
            <th>Cuidados especiales</th>
            <th>Disponible</th>
            <th>Ingreso</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mascota in Model)
        {
            <tr>
                <td>
                    <img src="@(mascota.FotoUrl ?? "/images/mascota-sin-foto.png")"
                         alt="@mascota.Nombre" style="width:50px;height:50px;object-fit:cover;border-radius:8px;" />
                </td>
                <td>@mascota.Nombre</td>
                <td>@mascota.Tipo</td>
                <td>@(mascota.Color ?? "-")</td>
                <td>@mascota.Edad</td>
                <td>@mascota.Sexo</td>
                <td>@string.Join(", ", mascota.EstadosSalud)</td>
                <td>
                    @if (mascota.EnTratamiento)
                    {
                        <span class="badge bg-warning text-dark me-1">Tratamiento</span>
                    }
                    @if (mascota.TieneEnfermedadBase)
                    {
                        <span class="badge bg-danger me-1">Enfermedad base</span>
                    }
                    @if (mascota.RequiereCuidadosLargoPlazo)
                    {
                        <span class="badge bg-info text-dark">Largo plazo</span>
                    }
                </td>
                <td>
                    @if (mascota.Disponible)
                    {
                        <span class="badge" style="background-color:var(--color-verde);">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td>@mascota.FechaIngreso.ToString("dd/MM/yyyy")</td>
                <td class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@mascota.Id" class="btn btn-sm btn-adoptapatitas-outline">Editar</a>
                    <a asp-action="Delete" asp-route-id="@mascota.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>Todavía no hay mascotas registradas.</p>
}