@model EcommerceApp.Models.Dog

@{
    ViewData["Title"] = Model?.Name ?? "Detalles";
}

<h1>@Model.Name</h1>

<div>
    <p><strong>Raza:</strong> @Model.Breed</p>
    <p><strong>Edad:</strong> @Model.Age</p>
    <p><strong>Tamaño:</strong> @Model.Size</p>
    <p><strong>Sexo:</strong> @Model.Gender</p>
    <p><strong>Descripción:</strong> @Model.Description</p>
    <p><strong>Estado:</strong> @(Model.IsAdopted ? "Adoptado" : "Disponible")</p>
</div>

<p>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
    @if (!Model.IsAdopted && User.IsInRole("Adoptante"))
    {
        <form asp-action="Adopt" method="post" style="display:inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-success">Adoptar</button>
        </form>
    }
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    }
</p>
